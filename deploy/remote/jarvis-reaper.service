[Unit]
Description=JARVIS independent browser cleanup
After=docker.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/jarvis
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/jarvis/tools/run_remote_worker.py --config /etc/jarvis-worker/worker.json --reap-once
UMask=0077
NoNewPrivileges=true
